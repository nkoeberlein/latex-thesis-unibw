% bold-extra.sty – LuaLaTeX-kompatible Version
% Original für zusätzliche fette Computer Modern Fonts
% Modernisiert für fontspec + Unicode

\ProvidesPackage{bold-extra}[2025/01/01 v2.0 LuaLaTeX-kompatible bold fonts]
\NeedsTeXFormat{LaTeX2e}

% --- Engine-Erkennung ---
\RequirePackage{iftex}

\ifLuaTeX
  % === LUALATEX: Verwende fontspec-Features ===
  \PackageInfo{bold-extra}{%
    LuaTeX detected. Using fontspec bold font features instead of NFSS.%
  }
  
  % Stelle sicher, dass fontspec geladen ist
  \@ifpackageloaded{fontspec}{}{%
    \RequirePackage{fontspec}
  }
  
  % --- Optionen (für Kompatibilität beibehalten) ---
  \newif\if@cmttb
  \DeclareOption{cmttb}{\@cmttbtrue}   
  \DeclareOption{cmbtt}{\@cmttbfalse}  
  \ExecuteOptions{cmttb}
  \ProcessOptions
  
  % --- Moderne Bold-Font-Definitionen ---
  % Computer Modern Unicode unterstützt verschiedene Bold-Gewichte nativ
  
  % Extra Bold für Überschriften
  \NewDocumentCommand{\textextrabold}{m}{%
    \bgroup
    \addfontfeatures{FakeBold=2.0}% Verstärkte Fettung
    #1%
    \egroup
  }
  
  % Bold Small Caps (modern)
  \NewDocumentCommand{\textboldsc}{m}{%
    \bgroup
    \addfontfeatures{
      Letters=SmallCaps,
      FakeBold=1.5
    }%
    #1%
    \egroup
  }
  
  % Bold Typewriter mit verstärkter Gewichtung
  \if@cmttb
    % Moderate Verstärkung
    \NewDocumentCommand{\textboldtt}{m}{%
      \bgroup
      \ttfamily
      \addfontfeatures{FakeBold=1.2}%
      #1%
      \egroup
    }
  \else
    % Starke Verstärkung (cmbtt-ähnlich)
    \NewDocumentCommand{\textboldtt}{m}{%
      \bgroup
      \ttfamily
      \addfontfeatures{FakeBold=2.5}%
      #1%
      \egroup
    }
  \fi
  
  % Kompatibilitäts-Makros für alte Befehle
  \let\oldbfseries\bfseries
  \renewcommand{\bfseries}{%
    \oldbfseries
    \addfontfeatures{FakeBold=0.3}% Leichte zusätzliche Verstärkung
  }
  
  % Alternative: Echte Bold-Fonts verwenden (falls verfügbar)
  \IfFontExistsTF{CMU Serif Extra Bold}{%
    \newfontfamily{\extrabold}{CMU Serif Extra Bold}[
      Ligatures=TeX
    ]
    \renewcommand{\textextrabold}[1]{{\extrabold #1}}
  }{}
  
  \IfFontExistsTF{CMU Typewriter Text Bold}{%
    \newfontfamily{\boldtt}{CMU Typewriter Text Bold}[
      Ligatures=TeX
    ]
    \renewcommand{\textboldtt}[1]{{\boldtt #1}}
  }{}
  
  % Small Caps Bold (wenn verfügbar)
  \IfFontExistsTF{CMU Serif Bold}{%
    \newfontfamily{\boldscfont}{CMU Serif Bold}[
      Letters=SmallCaps,
      Ligatures=TeX
    ]
    \renewcommand{\textboldsc}[1]{{\boldscfont #1}}
  }{}
  
  % Integration mit bestehenden Font-Befehlen
  \let\oldtextbf\textbf
  \renewcommand{\textbf}[1]{%
    % Intelligente Bold-Verstärkung je nach Kontext
    \ifmmode
      \oldtextbf{#1}% Mathe-Modus: Standard
    \else
      \textextrabold{#1}% Text-Modus: Verstärkt
    \fi
  }
  
\else
  % === ANDERE ENGINES: Original NFSS-Definitionen ===
  \PackageWarning{bold-extra}{%
    This package is optimized for LuaLaTeX. 
    Using legacy NFSS font definitions.%
  }
  
  % --- Optionen ---
  \newif\if@cmttb
  \DeclareOption{cmttb}{\@cmttbtrue}   
  \DeclareOption{cmbtt}{\@cmttbfalse}  
  \ExecuteOptions{cmttb}
  \ProcessOptions
  
  % --- Original NFSS-Definitionen ---
  \DeclareFontShape{OT1}{cmr}{b}{sc}{
    <5><6><7><8><9><10><12><10.95><14.4><17.28><20.74><24.88>cmbcsc10
  }{}
  \DeclareFontShape{OT1}{cmr}{bx}{sc}{
    <->ssub*cmr/b/sc
  }{}
  
  % Bold Typewriter
  \if@cmttb
    \DeclareFontShape{OT1}{cmtt}{b}{n}{
      <5><6><7><8><9><10><12><10.95><14.4><17.28><20.74><24.88>cmttb10
    }{}
  \else
    \DeclareFontShape{OT1}{cmtt}{b}{n}{
      <5><6><7><8>cmbtt8
      <9>cmbtt9
      <10><12><10.95><14.4><17.28><20.74><24.88>cmbtt10
    }{}
  \fi
  \DeclareFontShape{OT1}{cmtt}{bx}{n}{
    <->ssub*cmtt/b/n
  }{}
  
  % Kompatibilitäts-Befehle für LuaLaTeX-Syntax
  \providecommand{\textextrabold}[1]{\textbf{#1}}
  \providecommand{\textboldsc}[1]{\textsc{\textbf{#1}}}
  \providecommand{\textboldtt}[1]{\texttt{\textbf{#1}}}
\fi

% --- Utility-Befehle (engine-unabhängig) ---
% Für verschiedene Anwendungsfälle
\newcommand{\strong}[1]{\textextrabold{#1}}           % Sehr starke Betonung
\newcommand{\keyword}[1]{\textboldtt{#1}}             % Code-Keywords
\newcommand{\acronym}[1]{\textboldsc{#1}}             % Akronyme in Small Caps

% Umgebungen
\newenvironment{strongtext}{\textextrabold\bgroup}{\egroup}
\newenvironment{boldcode}{\ttfamily\textboldtt\bgroup}{\egroup}

% --- Debug-Information ---
\AtBeginDocument{%
  \typeout{=== Bold-Extra konfiguriert ===}
  \ifLuaTeX
    \typeout{Modus: fontspec + FakeBold}
    \typeout{Features: \string\textextrabold, \string\textboldsc, \string\textboldtt}
  \else
    \typeout{Modus: NFSS (legacy)}
    \typeout{Features: Originale Font-Shapes}
  \fi
  \typeout{==================================}
}

\endinput