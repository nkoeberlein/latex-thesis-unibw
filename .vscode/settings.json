{
  "latex-workshop.latex.recipes": [
    {
      "name": "lualatex + biber + makeglossaries",
      "tools": ["lualatex", "makeglossaries", "biber", "lualatex", "lualatex"]
    },
    {
      "name": "lualatex (schnell)",
      "tools": ["lualatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "--shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"]
    },
    {
      "name": "makeglossaries",
      "command": "makeglossaries",
      "args": ["%DOCFILE%"]
    }
  ],
  "latex-workshop.latex.recipe.default": "lualatex + biber + makeglossaries",
  "latex-workshop.view.pdf.viewer": "tab"
}
